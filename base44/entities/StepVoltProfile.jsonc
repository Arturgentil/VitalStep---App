{
  "name": "StepVoltProfile",
  "type": "object",
  "properties": {
    "operator_id": {
      "type": "string",
      "description": "Namespacing id for the owner of this profile"
    },
    "display_name": {
      "type": "string"
    },
    "birth_year": {
      "type": "number"
    },
    "height_cm": {
      "type": "number"
    },
    "weight_kg": {
      "type": "number"
    },
    "sex": {
      "type": "string",
      "enum": [
        "female",
        "male",
        "other",
        "undisclosed"
      ]
    },
    "daily_step_goal": {
      "type": "number",
      "default": 8000
    },
    "daily_energy_goal_mwh": {
      "type": "number",
      "default": 120
    },
    "weekly_minutes_goal": {
      "type": "number",
      "default": 150
    },
    "onboarded": {
      "type": "boolean",
      "default": false
    },
    "public_profile": {
      "type": "boolean",
      "default": false
    },
    "share_routes": {
      "type": "boolean",
      "default": false
    },
    "share_health": {
      "type": "boolean",
      "default": false
    },
    "notify_achievements": {
      "type": "boolean",
      "default": true
    },
    "notify_alerts": {
      "type": "boolean",
      "default": true
    },
    "hrmax": {
      "type": "number"
    },
    "bpm_alert_min": {
      "type": "number",
      "default": 50
    },
    "bpm_alert_max": {
      "type": "number",
      "default": 165
    },
    "spo2_alert_min": {
      "type": "number",
      "default": 92
    },
    "temp_alert_max": {
      "type": "number",
      "default": 38
    },
    "fall_detection": {
      "type": "boolean",
      "default": false
    },
    "fall_sensitivity": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "default": "medium"
    },
    "reduced_motion": {
      "type": "boolean",
      "default": false
    },
    "theme": {
      "type": "string",
      "enum": [
        "dark",
        "light"
      ],
      "default": "dark"
    },
    "consent_health": {
      "type": "boolean",
      "default": false
    },
    "consent_location": {
      "type": "boolean",
      "default": false
    },
    "consent_ai": {
      "type": "boolean",
      "default": false
    },
    "consent_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_report_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "operator_id"
  ]
}